# Aarogya Hospital Management System - Server Environment Variables

# Server Port (Render / Railway set this automatically)
PORT=4000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# Example MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hospital_management?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/hospital_management

# JWT Secret Key for token signing
JWT_SECRET=aarogya_hospital_secure_jwt_token_key_2026

# Allowed Frontend Client Origin(s) for CORS (comma-separated or * for all)
# Example: https://your-frontend.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# Cloudinary Credentials (Optional - for diagnostic image & scan uploads)
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret